<launch>

  <arg name="model_path" default="$(find quad_amcl)/models"/>
  <arg name="map_path" default="$(find quad_amcl)/maps/Yacht_Club_RG/map.ini"/>
  <arg name="bag_file" />
  <arg name="viewer" default="true"/>
  <arg name="record" default="true"/>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] [${node}]: ${message}"/>
  <env name="TF_FORCE_GPU_ALLOW_GROWTH" value="true"/>

  <param name="use_sim_time" value="true"/>

  <node pkg="quad_amcl" name="particle_filter" type="particle_filter"
        respawn="false" output="screen">
    <param name="image_transport" value="compressed"/>
    <param name="map_path" value="$(arg map_path)"/>
    <param name="test" value="false"/>
    <param name="orientation_test" value="false"/>
    <param name="disable_orientation" value="true"/>

    <remap from="pose" to="pose_gt"/>
  </node>

  <node pkg="rosbag" name="rosbag_play" type="play"
        respawn="false" output="screen"
        args="$(arg bag_file) --clock -r 8.0 -s 1850 -q">
  </node>

  <node pkg="quad_amcl" name="quadruplet" type="quadruplet.py"
        respawn="false" output="screen">
    <param name="model_path" value="$(arg model_path)"/>
  </node>

  <!-- Visualization -->
  <node if="$(arg viewer)" pkg="rqt_gui" name="son_sat_view" type="rqt_gui"
     respawn="false" output="screen"
     args="--perspective-file $(find quad_amcl)/cfg/pf_viewer.perspective"/>

  <!-- Record -->
  <node if="$(arg record)" pkg="rosbag" name="rosbag_record" type="record"
     respawn="false"
     args="-O $(find quad_amcl)/bags/result.bag
        /son_small
        /son/compressed
        /pf_pose
        /pf_avg5_pose
        /pf_avg10_pose
        /pf_avg15_pose
        /odom_pose
        /sat_crop
        /pose_gt
        /map_img
        /particles_view">
  </node>

</launch>